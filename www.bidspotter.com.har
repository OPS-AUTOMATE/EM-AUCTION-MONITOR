            "text": "\r\n\r\nfunction processValue(attr, type, prev) {\r\n    function SetCookie(name, value, daysTillExpiry, path) {\r\n        var cookie = name + '=' + escape(value) + ';';\r\n        if (daysTillExpiry) {\r\n            var date = new Date();\r\n            date.setDate(date.getDate() + daysTillExpiry);\r\n            cookie += ' expires=' + date.toUTCString() + ';';\r\n        }\r\n\r\n        // Set path (defaults to '/' ; scope global to the site)\r\n        cookie += ' path=' + (path || '/') + ';';\r\n        document.cookie = cookie;\r\n    }\r\n\r\n    // retrieve and update the attribute given from local storage\r\n    // its type, prsence and previous result \r\n    // store the update \r\n    //\r\n    var val = localStorage.getItem(attr);\r\n    var isPresent = (val != null);\r\n    var newVal = val; // the default\r\n    var ret = false; // no change - true triggers change\r\n    var lsupdate = true;\r\n    var dlupdate = true;\r\n    var globalIdCookieName = 'globalId';\r\n    //\r\n    var dl = window.dataLayer[0]; // guranteed to exist  \r\n    //\r\n    // do process \r\n    //  \r\n    // always store newval to datalayer and ls \r\n    switch (type) {\r\n        case 'uid':\r\n            {\r\n                if (isPresent != true) {\r\n                    newVal = ('' + Math.floor(Math.random() * 1000000000)) + Math.floor(Math.random() * 1000000000);\r\n                }\r\n                else\r\n                    lsupdate = false;\r\n            }\r\n            break;\r\n        case 'timeout':\r\n            {\r\n                var dn = Date.now();\r\n                if (isPresent) {\r\n                    var li = parseInt(val, 10);\r\n                    if ((dn - li) > 1800000) {\r\n                        ret = true; // generate reset \r\n                    }\r\n                }\r\n                else\r\n                    ret = true; // generate reset\r\n                dlupdate = false;  // do not push to datalayer\r\n                newVal = dn;   // reset timeout\r\n            }\r\n            break;\r\n        case 'counter':\r\n            {\r\n                if (prev || !isPresent || val == 'NaN') {   // a change so reset\r\n                    newVal = 1;\r\n                }\r\n                else {\r\n                    newVal = parseInt(val, 10) + 1;\r\n                }\r\n            }\r\n            break;\r\n        case 'session':  // stay the same unless trigered \r\n            {\r\n                var li = isPresent ? parseInt(val, 10) : 0;\r\n\r\n                if (prev) {\r\n                    newVal = li + 1;\r\n                    // new session reset session cookie\r\n                    setFiredEventCookie(\"\");\r\n                    ret = true; // trigger anything below\r\n                }\r\n                else {\r\n                    newVal = li;\r\n                    lsupdate = false;\r\n                }\r\n                //\r\n                // Set returning user as cookie so that it can be used server-side\r\n                var returning = newVal > 1 ? true : false;\r\n                document.cookie = 'returningUser=' + returning + '; path=/;';\r\n            }\r\n            break;\r\n        case 'sessionid':\r\n            {\r\n                // bespoke just combine globalid and session number from datalayer\r\n                newVal = dl.globalId + '-' + dl.sessionNumber;\r\n                lsupdate = false; // but update datalayer\r\n            }\r\n            break;\r\n        case 'mirror': // if it is in datalayer copy to ls\r\n            {           // if it is in ls copy to datalayer\r\n                // ignore previous result\r\n                lsupdate = false;\r\n                dlupdate = false;\r\n                if (isPresent && val != 'null') {\r\n                    newVal = val;\r\n                    dlupdate = true; // this will override as we get new values\r\n                } else {\r\n                    // if it is in datalayer copy it to local storage \r\n                    if (dl.hasOwnProperty(attr)) {\r\n                        newVal = dl[attr];\r\n                        lsupdate = true; // push into local storage \r\n                    }\r\n                }\r\n            }\r\n            break;\r\n        case 'userStatus':\r\n            {\r\n                // just check session number to be greater than one\r\n                lsupdate = false;\r\n                if (dl.sessionNumber > 1)\r\n                    newVal = 'returning'\r\n                else\r\n                    newVal = 'new';\r\n            }\r\n            break;\r\n        case 'setLS': {\r\n            newVal = prev;\r\n            lsupdate = true;\r\n        }\r\n            break;\r\n        case 'event': {\r\n            processEvent(prev, attr);\r\n        }\r\n            break;\r\n        default:\r\n            return ret;\r\n    }\r\n    //  \r\n    if (lsupdate) {\r\n        localStorage.setItem(attr, newVal);\r\n    }\r\n    //\r\n    if (dlupdate) {\r\n        dl[attr] = newVal;\r\n    }\r\n\r\n    if (attr === globalIdCookieName) {\r\n        SetCookie(globalIdCookieName, newVal, 365);\r\n    }\r\n\r\n    //\r\n    return ret; // this will inform next value\r\n}\r\n\r\nfunction processEvent(guid, name, model) {\r\n    var firedEventIds = getFiredEventCookie();\r\n    if (firedEventIds.indexOf(guid) === -1) {\r\n        if (model == null) {\r\n            dataLayer.push({ 'event': name });\r\n        } else {\r\n            //Object.assign does not work in IE so here's a workaround\r\n            var objectArray = [{ 'event': name }, model];\r\n            var eventToPush = objectArray.reduce(function (result, source) {\r\n                Object.keys(source).forEach(function (key) {\r\n                    result[key] = source[key];\r\n                });\r\n                return result;\r\n            }, {});\r\n\r\n            dataLayer.push(eventToPush);\r\n        }\r\n        addFiredEventId(guid);\r\n    }\r\n}\r\n\r\nfunction processValues(specs) {\r\n    // expect an array of arrays \r\n    // \r\n    try {\r\n        var result = false; // feed into next as 3rd arg\r\n        for (var i = 0; i < specs.length; i++) {\r\n            var spec = specs[i];\r\n            result = processValue(spec[0], spec[1], result);\r\n        }\r\n    }\r\n    catch (ex) {\r\n        window.dataLayer[0].dlerror = ex.message;\r\n    }\r\n}\r\n\r\nfunction addFiredEventId(guid) {\r\n    var firedEventIds = getFiredEventCookie();\r\n    var updatedFiredEventIds = firedEventIds + guid + \"|\";\r\n\r\n    setFiredEventCookie(updatedFiredEventIds);\r\n}\r\n\r\nfunction setFiredEventCookie(value) {\r\n    document.cookie = \"firedEventIds=\" + (value || \"\") + \"; path=/\";\r\n}\r\nfunction getFiredEventCookie() {\r\n    var name = \"firedEventIds=\";\r\n    var ca = document.cookie.split(';');\r\n    for (var i = 0; i < ca.length; i++) {\r\n        var c = ca[i];\r\n        while (c.charAt(0) == ' ') c = c.substring(1, c.length);\r\n        if (c.indexOf(name) == 0) return c.substring(name.length, c.length);\r\n    }\r\n    return \"\";\r\n}"
          },
