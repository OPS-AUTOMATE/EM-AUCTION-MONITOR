ubmitJumpToLot() {\r\n            var gotToLotNumber = $('#txtJumpToLotNumber').val();\r\n\r\n            if (validateLotNumber(gotToLotNumber)) {\r\n                var url = '/en-us/auction-catalogues/bscfra/catalogue-id-bscfra10019/url-for-lot-number';\r\n\r\n                $.ajax({\r\n                    type: 'GET',\r\n                    url: url,\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    data:\r\n                    {\r\n                        lotNumber: gotToLotNumber\r\n                    },\r\n                    success: function(data) { getLotUrlSuccess(data); },\r\n                    error: function() { getLotUrlFail(); }\r\n                });\r\n\r\n            }\r\n            return false;\r\n        };\r\n\r\n        function getLotUrlSuccess(data) {\r\n            // transfer to the returned url\r\n            document.location.href = data.Url;\r\n        };\r\n\r\n        function getLotUrlFail() {\r\n            ShowNotification('info', portalScriptResources.SearchCouldNotFindLot, portalScriptResources.SearchTryDifferentLot);\r\n        };\r\n\r\n\r\n        function validateLotNumber(number) {\r\n            var pattern = new RegExp(\"^[\\\\p{L}\\\\p{N}\\\\-\\\\.\\\\u2026]+$\", \"u\");\r\n            if (pattern.test(number)) {\r\n                return true;\r\n            } else {\r\n                // Show message\r\n                ShowNotification('error', portalScriptResources.SearchInvalidLotNumber, portalScriptResources.SearchEnterLotNumber);\r\n                return false;\r\n            }\r\n        }\r\n\r\n    </script>\r\n\r\n\r\n                    \r\n<div class=\"ui basic segment auction-closed \">\r\n    <input type=\"hidden\" id=\"lot-is-ended\" value=\"true\" />\r\n\r\n    <div class=\"Rtable Rtable--2cols Rtable--collapse\">\r\n            <div class=\"Rtable Rtable-cell--row\">\r\n                <div class=\"Rtable-cell Rtable-cell--1of3 Rtable-cell--rowEnd\">\r\n 