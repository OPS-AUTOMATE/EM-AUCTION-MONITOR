alt=\"No Image\" src=\"/content/sr/images/blank-image.png\">\r\n    </span> \r\n\r\n                                </div>\r\n                                <div class=\"description\">\r\n                                    <span class=\"lot-number\"><strong>Lot 421</strong></span>\r\n                                    Mfg 2023 Goulds Booster Pump Model: 33GBS3017N4, Baldor Super-E 3HP Motor, 3 Phase, 3450 RPM\r\n                                </div>\r\n                                <div class=\"controls\">\r\n                                    <span>Next Lot</span>\r\n                                </div>\r\n                            </a>\r\n                        </div>\r\n                    </div>\r\n\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n<!-- SEO tags -->\r\n<div class=\"twelve wide tablet only nine wide computer column\">\r\n    <div class=\"seo-tags\">\r\n        <div class=\"ui divider\"></div>\r\n        <div class=\"ui list\">\r\n            <div class=\"item\">\r\n                <div class=\"content\">\r\n                    <p><strong>Tags:</strong> <span>Carefusion, <a href='/en-us/search-ventilator'>Ventilator</a></span></p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>    </div>\r\n</div>\r\n\r\n\r\n\r\n\r\n<div class=\"similar-items-available-now\">\r\n    <a2o-similar-lots-widget id=\"similar-lots-same-platform\" style=\"display: block; margin-left: auto; margin-right: auto;\" lotid=\"72c51cb1-2ad9-48a7-805d-b3c2014fb5ee\" culture=\"en-us\" platformcode=\"BSC\" count=\"30\" originsystem=\"GAP\" variant=\"1\"></a2o-similar-lots-widget>\r\n    \r\n    \r\n    <script src=\"/similar-lots/ui/polyfills.js?v=07152025\" type=\"module\"></script>\r\n    <script src=\"/similar-lots/ui/main.js?v=07152025\" type=\"module\"></script>\r\n</div>\r\n\r\n<script type=\"text/javascript\">\r\n(function() {\r\n    var samePlatformClickPosition = 0;\r\n    var crossPlatformClickPosition = 0;\r\n    \r\n    // Function to validate OneTrust performance cookies consent\r\n    function validateOneTrustPerformanceConsent() {\r\n        try {\r\n            if (typeof OnetrustActiveGroups !== 'undefined' && OnetrustActiveGroups) {\r\n                return OnetrustActiveGroups.includes('C0002');\r\n            }\r\n            \r\n            return document.cookie.indexOf('C0002:1') !== -1;\r\n        } catch (e) {\r\n            return false;\r\n        }\r\n    }\r\n    \r\n    function setupAmplitudeTracking() {\r\n        // Check if Amplitude is available\r\n        if (typeof window.amplitude === 'undefined') {\r\n            console.warn('[Amplitude] Amplitude not available for lot recommendation tracking');\r\n            return;\r\n        }\r\n        \r\n        // Check OneTrust performance cookies consent\r\n        if (!validateOneTrustPerformanceConsent()) {\r\n            console.log('[Amplitude] Lot recommendation tracking blocked due to performance cookies consent not granted');\r\n            return;\r\n        }\r\n        \r\n        console.log('[Amplitude] Setting up similar lots tracking...');\r\n        \r\n        // Set up individual handlers for each widget\r\n        setupWidgetHandler('similar-lots-same-platform', 'same-platform');\r\n        setupWidgetHandler('similar-lots-cross-platform', 'cross-platform');\r\n    }\r\n    \r\n    function setupWidgetHandler(widgetId, widgetType) {\r\n        const checkForWidget = setInterval(function() {\r\n            var widget = document.getElementById(widgetId);\r\n            if (widget) {\r\n                clearInterval(checkForWidget);\r\n                widget.addEventListener('lotRecommendationClick', function(event) {\r\n                    handleLotRecommendationClick(event, widgetType);\r\n                });\r\n                console.log('[Amplitude] Event listener attached to ' + widgetId);\r\n            }\r\n        }, 100);\r\n        \r\n        // Clear interval after 10 seconds\r\n        setTimeout(function() { clearInterval(checkForWidget); }, 10000);\r\n    }\r\n    \r\n    function handleLotRecommendationClick(event, widgetType) {\r\n        try {\r\n            // Increment click position for this widget type\r\n            var clickPosition;\r\n            \r\n            if (widgetType === 'same-platform') {\r\n                samePlatformClickPosition++;\r\n                clickPosition = samePlatformClickPosition;\r\n            } else if (widgetType === 'cross-platform') {\r\n                crossPlatformClickPosition++;\r\n                clickPosition = crossPlatformClickPosition;\r\n            }\r\n            \r\n            // Get event data from the Angular component\r\n            var eventDetail = event.detail;\r\n            var lot = eventDetail.lot;\r\n            var finalUrl = eventDetail.url;\r\n            \r\n            // Get the widget element to read its attributes for recommendation naming\r\n            var widgetElement = event.target;\r\n            var variant = widgetElement.getAttribute('variant');\r\n            var originSystem = widgetElement.getAttribute('originsystem');\r\n            var excludePlatformCodes = widgetElement.getAttribute('excludeplatformcodes');\r\n            \r\n            // Determine recommendation name using original logic\r\n            var recommendationName = getRecommendationName(variant, originSystem, excludePlatformCodes, lot);\r\n            \r\n            // Build tracking data conforming to LotRecommendationClicked.cs schema\r\n            var trackingData = {\r\n                'Catalog Id': 'ab296a5e-cdae-4d04-8663-b3a80169a82e',\r\n                'House Id': '3e70fd01-49c5-4796-ad04-a29300f9aecf',\r\n                'Item Id': lot.lotId,\r\n                'Lot Click Position': clickPosition,\r\n                'Page Name': window.location.pathname,\r\n                'Recommendation Name': recommendationName,\r\n                'Trigger': 'similar_lots_widget',\r\n                'Url': finalUrl\r\n            };\r\n            \r\n            // Send tracking event via client-side Amplitude\r\n            window.amplitude.track('Lot Recommendation Clicked', trackingData);\r\n            \r\n            console.log('[Amplitude] Tracked lot recommendation click:', trackingData);\r\n            \r\n        } catch (error) {\r\n            console.warn('[Amplitude] Error tracking recommendation click:', error);\r\n        }\r\n    }\r\n    \r\n    function getRecommendationName(variant, originSystem, excludePlatformCodes, lot) {\r\n        // Check if lot is from a different platform than the current page\r\n        var isCurrentPlatform = lot.platformCode === 'BSC';\r\n        \r\n        if (variant === '5' || excludePlatformCodes) {\r\n            if (!isCurrentPlatform) {\r\n                return 'Similar Lots - Cross Platform - ' + lot.platformCode;\r\n            } else {\r\n                return 'Similar Lots - Cross Platform';\r\n            }\r\n        } else if (variant === '1' && originSystem === 'GAP') {\r\n            return 'Similar Lots - GAP';\r\n        } else {\r\n            return 'Similar Lots - Widget ' + variant;\r\n        }\r\n    }\r\n\r\n    \r\n    // Initialize tracking when DOM is ready\r\n    if (document.readyState === 'loading') {\r\n        document.addEventListener('DOMContentLoaded', setupAmplitudeTracking);\r\n    } else {\r\n        setupAmplitudeTracking();\r\n    }\r\n})();\r\n</script>\r\n\r\n        <div class=\"ui basic segment auction-alert-cta \">\r\n            <div>\r\n                <a href=\"/en-us/search-results?CategoryCode=MED\" target=\"_self\" class=\"ui button primary\" id=\"browseRelatedItems\"><span>Browse related items</span></a>\r\n            </div>\r\n        </div>\r\n\r\n    <div class=\"touch-swipe-gallery\">\r\n        <div id=\"sliderContainer\" class=\"sliderHolder\" data-elem=\"sliderHolder\" style=\"display: none\">\r\n            <div id=\"z