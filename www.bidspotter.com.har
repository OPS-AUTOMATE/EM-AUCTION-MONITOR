t.bidspotter.com/hc/en-gb/articles/115000787834-How-To-Buy\" target=\"_blank\">How to Buy</a>\r\n</li>\r\n<li class=\"side-menu__label--menu_item\">\r\n    <a href=\"https://support.bidspotter.com/hc/en-gb/articles/115000783153-How-To-Sell\" target=\"_blank\">How to Sell</a>\r\n</li>\r\n<li class=\"side-menu__label--menu_item\">\r\n    <a id=\"nav_mobile_supportChat\" class=\"chat-trigger icon chat-icon\" href=\"#\" target=\"_blank\" onclick=\"closeHamburgerMenu()\">Live Chat</a>\r\n</li>\r\n\r\n        </ul>\r\n    </div>\r\n</nav>\r\n\r\n<script type=\"text/javascript\">\r\n    function togglePageScrolling() {\r\n        $('body').toggleClass('menu-open');\r\n    }\r\n\r\n    function closeHamburgerMenu() {\r\n        var checkboxes = document.getElementsByClassName('side-menu__checkbox');\r\n        for (var i = 0; i < checkboxes.length; i++) {\r\n            checkboxes[i].checked = false;\r\n        }\r\n        togglePageScrolling();\r\n    }\r\n</script>\r\n        </div>\r\n        <div class=\"gap-header__logo\">\r\n            <a id=\"logo\" href=\"/en-us\">\r\n<img src=\"/Content/BSC/images/site-logo_v2.png\" />\r\n            </a>\r\n        </div>\r\n        <div class=\"gap-header__search\">\r\n\r\n\r\n<div class=\"main-search\">\r\n    <fieldset class=\"lot-search\">\r\n        <legend class=\"hide\">Search for lots</legend>\r\n        <form id=\"main-search-form\" class=\"main-search-form\" action=\"/en-us/search-results\">\r\n            <label for=\"main-search-term\" aria-label=\"main-search-term\"><span class=\"a11y\">Main Search</span></label>\r\n            <input id=\"main-search-term\" class=\"main-search-term top-nav-search\" name=\"searchTerm\" type=\"text\" placeholder=\"Search lots...\" value=\"\" data-gap-ac-url=\"/en-us/lot-search-autocomplete\" autocomplete=\"off\" />\r\n            <div class=\"search-auto-complete recent-search search-panel\">\r\n                <div class=\"container\">\r\n                    <h2>Recent searches</h2>\r\n                    <ul class=\"recent-search-select\"></ul>\r\n                    <div class=\"clear-all\">Clear all</div>\r\n                </div>\r\n            </div>\r\n            <div class=\"search-auto-complete suggested-search search-panel\">\r\n                <div class=\"container\">\r\n                    <h2>Suggested searches</h2>\r\n                    <ul class=\"suggested-search-select\"></ul>\r\n                </div>\r\n            </div>\r\n            <button id=\"main-search_btn\" type=\"button\" class=\"main-search-submit search-button\" aria-label=\"search-button\"><span class=\"icon icon-search\"></span></button>\r\n        </form>\r\n    </fieldset>\r\n</div>\r\n\r\n<script src=\"/js/controls/searchassist?v=U1rG3LQbQ1QAoRYxbC594TLlSVIlq66PVHI5VQP1yTs1\"></script>\r\n\r\n\r\n<script type=\"text/javascript\">\r\n    $(document).ready(function () {\r\n        var grs = new GapRecentlySearched(\"#main-search-form\", submitHandler),\r\n            $form = $('.main-search-form'),\r\n            $searchTerm = $(\"#main-search-term\", $form);\r\n\r\n        $form.attr('onsubmit', 'AddSearchParametersToQuerystring(this);');\r\n        $(\".main-search-submit\").on(\"click\", submitHandler);\r\n\r\n        function submitHandler() {\r\n\r\n            var modes = { none: 0, recent: 1, suggested: 2 }\r\n\r\n            if (window.dataLayer) {\r\n                window.dataLayer.push({\r\n                    event: 'PlacedSearch',\r\n                    searchedItem: $searchTerm.val()\r\n                });\r\n            }\r\n\r\n            if ($(\"#main-search-form\").data('mode') === modes.recent)\r\n            {\r\n                if (window.dataLayer) {\r\n                    window.dataLayer.push({\r\n                        event: 'ClickedOnSearchOverlay',\r\n                        searchedItem: $searchTerm.val(),\r\n                        searchType: 'Recent search'\r\n                    });\r\n                }\r\n            }\r\n\r\n            if ($(\"#main-search-form\").data('mode') === modes.suggested) {\r\n                if (window.dataLayer) {\r\n                    window.dataLayer.push({\r\n                        event: 'ClickedOnSearchOverlay',\r\n                        searchedItem: $searchTerm.val(),\r\n                        searchType: 'Suggested search'\r\n                    });\r\n                }\r\n            }\r\n\r\n            grs.storeTerm();\r\n            $searchTerm.val(searchStrip($searchTerm.val()));\r\n            $form.submit();\r\n        }\r\n\r\n    });\r\n</script>\r\n        </div>\r\n        <div class=\"gap-header__auction-dropdown\">\r\n\r\n\r\n<div id=\"nav_auctions\" class=\"gap-header__button gap-header__button--large gap-header__button--rounded gap-header__button--hover\">\r\n    <button type=\"button\"\r\n            aria-haspopup=\"true\"\r\n            aria-expanded=\"true\"\r\n            aria-controls=\"bsc-auction-dropdown\">\r\n        Find Auctions<span class=\"gap-header__button--icon-arrow\"></span>\r\n    </button>\r\n    <ul class=\"gap-header__button--dropdown\" id=\"bsc-auction-dropdown\">\r\n        <li><a id=\"nav_auctions_submenu_featured_lots\" href=\"/en-us/featured-lots\">Featured Lots</a></li>\r\n        <li><a href=\"/en-us/auction-catalogues/search-filter?AuctionType=Live\">Live Auctions</a></li>\r\n        <li><a href=\"/en-us/auction-catalogues/search-filter?AuctionType=Timed\">Timed Auctions</a></li>\r\n        <li><a href=\"/en-us/auction-catalogues\">All Auctions</a></li>\r\n        <li><a href=\"/en-us/auctioneers\">Auctioneers Directory</a></li>\r\n        <li><a href=\"/en-us/premier-auctioneers\">Premier Auctioneers</a></li>\r\n    </ul>\r\n</div>\r\n        </div>\r\n        <div class=\"gap-header__content-buttons\">\r\n                <div class=\"gap-header__button gap-header__button--rounded gap-header__button--large gap-header__button--minwidth-80 gap-header__button--hover\">\r\n                    <a id=\