\n                                                    </time>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n\r\n                            </div>\r\n                                <!-- Venue address -->\r\n                                <div class=\"twelve wide column\">\r\n                                    <div>\r\n                                        <h5 class=\"h5\">Venue Address</h5>\r\n                                        <div class=\"ui list\">\r\n                                            <address>\r\n                                                <div class=\"item\">\r\n                                                    12589 Rhode Island Ave\r\n                                                </div>\r\n                                                <div class=\"item\">\r\n                                                    \r\n                                                </div>\r\n                                                <div class=\"item\">\r\n                                                    \r\n                                                </div>\r\n                                                <div class=\"item\">\r\n                                                    \r\n                                                </div>\r\n                                                <div class=\"item\">\r\n                                                    Savage\r\n                                                </div>\r\n                                                <div class=\"item\">\r\n                                                    Minnesota\r\n                                                </div>\r\n                                                <div class=\"item\">\r\n                                                    55378\r\n                       